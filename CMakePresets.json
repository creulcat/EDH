{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Release",
            "description": "Visual Studio / MSVC Release build",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Debug",
            "description": "Visual Studio / MSVC Debug build",
            "inherits": "windows-msvc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-ninja-release",
            "displayName": "Windows Ninja Release",
            "description": "Ninja + MSVC Release build",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "description": "Unix Makefiles Release build",
            "inherits": "base",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "description": "Unix Makefiles Debug build",
            "inherits": "linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-release",
            "displayName": "macOS Release",
            "description": "Unix Makefiles Release build for macOS",
            "inherits": "base",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Debug",
            "description": "Unix Makefiles Debug build for macOS",
            "inherits": "macos-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc-release",
            "configuration": "Release",
            "targets": ["Towhitch", "dist"]
        },
        {
            "name": "windows-msvc-debug",
            "configurePreset": "windows-msvc-debug",
            "configuration": "Debug",
            "targets": ["Towhitch", "dist"]
        },
        {
            "name": "windows-ninja-release",
            "configurePreset": "windows-ninja-release",
            "targets": ["Towhitch", "dist"]
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "targets": ["Towhitch", "dist"]
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "targets": ["Towhitch", "dist"]
        },
        {
            "name": "macos-release",
            "configurePreset": "macos-release",
            "targets": ["Towhitch", "dist"]
        },
        {
            "name": "macos-debug",
            "configurePreset": "macos-debug",
            "targets": ["Towhitch", "dist"]
        }
    ]
}
